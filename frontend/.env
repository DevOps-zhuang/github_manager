# React App Environment Configuration
# This file fixes the webpack dev server error on Windows

# Skip the preflight check that causes the "allowedHosts" error
SKIP_PREFLIGHT_CHECK=true

# Backend API URL (used by frontend to connect to Flask)
REACT_APP_API_URL=http://localhost:5000

# Disable browser automatic opening
BROWSER=none

# Port for development server
PORT=3000
