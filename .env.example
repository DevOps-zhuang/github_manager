#############################################
# AI & 邀请统一配置示例 (.env.example)
# 将本文件复制为 .env 并填写实际值
#############################################

# 选择模型供应商类型: openai | github | azure | custom
# openai  : 官方 OpenAI 平台（无需 API_BASE_URL）
# github  : GitHub Models (内部会映射默认 endpoint, 可省略 API_BASE_URL)
# azure   : Azure OpenAI（必须提供 API_BASE_URL）
# custom  : 自建/代理/其他第三方，必须提供 API_BASE_URL
API_TYPE=openai

# 模型访问密钥：
#  - openai: 平台 API Key
#  - github: 优先使用 API_KEY；若缺少且存在 GITHUB_TOKEN，可尝试回退
#  - azure/custom: 必填
API_KEY=replace-with-your-api-key

# 模型名称，默认 gpt-4o，可根据供应商调整；github 模型内部会自动处理命名映射
MODEL_NAME=gpt-4o

# 仅在 API_TYPE=azure 或 custom 时必填；其余可留空
# 示例：
#   Azure: https://your-resource.openai.azure.com/openai/v1/
#   自定义: https://your-proxy-endpoint/v1/
API_BASE_URL=

# 仅 Azure 旧版本或特定接口需要，若不清楚可留空
API_VERSION=

# （可选）默认组织，用于不在 CLI 明确指定 --organization 时的邀请流程
DEFAULT_ORGANIZATION=

# （可选）团队统一前缀，邀请前会尝试给团队名补上此前缀（若未包含）
DEFAULT_TEAM_PREFIX=

# GitHub Token：用于邀请（GitHub API），与模型调用分离；
# 当 API_TYPE=github 且 API_KEY 为空时，系统可能尝试回退使用此 Token 调模型（给出警告）。
GITHUB_TOKEN=replace-with-github-pat-for-invitations

# =====================
# 示例参考（取消注释对照使用）
#
# OpenAI:
# API_TYPE=openai
# API_KEY=sk-xxxx
# MODEL_NAME=gpt-4o
#
# GitHub Models:
# API_TYPE=github
# API_KEY=ghu_xxx   # 若无可留空并依赖 GITHUB_TOKEN 回退
# GITHUB_TOKEN=github_pat_xxx
# MODEL_NAME=gpt-4o
#
# Azure OpenAI:
# API_TYPE=azure
# API_KEY=azure-key-xxx
# API_BASE_URL=https://your-resource.openai.azure.com/openai/v1/
# MODEL_NAME=gpt-4o
# API_VERSION=2024-02-15-preview
#
# 自定义代理:
# API_TYPE=custom
# API_KEY=proxy-key-xxx
# API_BASE_URL=https://my-proxy.internal/api/v1/
# MODEL_NAME=gpt-4o
# =====================
#############################################
### 结束
#############################################
#   GitHub Models (dev/test): https://models.github.ai/inference
#   Azure OpenAI Response API (production): https://open-direct.openai.azure.com/openai/v1/
#   Azure OpenAI Legacy (if needed): https://YOUR_RESOURCE.openai.azure.com/
# OPENAI_BASE_URL=https://models.github.ai/inference

# API Version - Only needed for legacy Azure OpenAI endpoints (optional)
# For newer Azure Response API, this is not required
# Example: 2024-02-15-preview
# OPENAI_API_VERSION=2024-02-15-preview

# GitHub Token (for invitation operations)
GITHUB_TOKEN=your-github-token-here
