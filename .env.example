# OpenAI API Configuration (for AI-assisted data normalization)

# API Key - Get your API key from: https://platform.openai.com/api-keys
# For GitHub Models, use GITHUB_TOKEN instead
OPENAI_API_KEY=your-openai-api-key-here
# GITHUB_TOKEN=github_pat_your-token-here

# Model - Specify which model to use (default: gpt-4o)
# For OpenAI/Azure: gpt-4o, gpt-4, gpt-4-turbo, gpt-3.5-turbo
# For GitHub Models: openai/gpt-4o, openai/gpt-4o-mini, openai/gpt-4-turbo
OPENAI_MODEL=gpt-4o

# Base URL - API endpoint (optional, for GitHub Models or Azure OpenAI)
# Examples:
#   GitHub Models (dev/test): https://models.github.ai/inference
#   Azure OpenAI Response API (production): https://open-direct.openai.azure.com/openai/v1/
#   Azure OpenAI Legacy (if needed): https://YOUR_RESOURCE.openai.azure.com/
# OPENAI_BASE_URL=https://models.github.ai/inference

# API Version - Only needed for legacy Azure OpenAI endpoints (optional)
# For newer Azure Response API, this is not required
# Example: 2024-02-15-preview
# OPENAI_API_VERSION=2024-02-15-preview

# GitHub Token (for invitation operations)
GITHUB_TOKEN=your-github-token-here
