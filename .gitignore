# Ignore normalized/enterprise CSVs and reports that may contain user emails
invitation/normalizers/*.csv
invitation/normalizers/*_apply.csv
invitation/normalizers/*_normalized.csv
invitation/reports/*

# Ignore all enterprise-specific customizations and data
invitation/customize/
logs/

# Python virtual env
venv/

# Bytecode
__pycache__/
*.pyc

# Editor config
.vscode/

# Environment variables and secrets
# Allow example and development .env files but exclude local overrides
.env.local
.env.*.local
!frontend/.env
!frontend/.env.example
!frontend/.env.development

# Test artifacts (excluding tests/ directory which contains test source code)
.pytest_cache/
*.log
/*test_*
demo_apply.csv
*.csv

# Web runtime data
runtime/

# Frontend
frontend/node_modules/
frontend/build/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*


